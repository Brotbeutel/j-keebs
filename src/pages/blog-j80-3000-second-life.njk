            <h1 data-i18n="post4.title">J80-3000 – einer alten Cherry ein zweites Leben geben</h1>
        </section>

        <section class="section">
            <div class="section__inner article-body">
            <figure class="single-polaroid blog-article-photo" style="--tilt:-1deg;">
                <img src="images/J80-3000_open_with_printed_plate.jpg" width="1920" height="1080" loading="eager" decoding="async" alt="J80-3000 mit gedruckter Switch-Plate geöffnet" title="J80-3000 mit gedruckter Switch-Plate" data-i18n-attr="alt:post4.image.alt,title:post4.image.title">
